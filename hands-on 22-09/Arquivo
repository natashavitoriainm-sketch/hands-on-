     opcao = entrada.nextInt();
     
     switch (opcao) {
         
     case 1:
     System.out.print("Digite o valor do depósito: ");
     valor = entrada.nextDouble();
    
     if (valor > 0) {
     saldo = saldo + valor;
     
     System.out.print("O valor do saldo: " + saldo + "O valor e " + valor + ".");
     }
     else {
